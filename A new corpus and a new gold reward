        "import random\n",
        "from collections import defaultdict\n",
        "\n",
        "# 1. Corpus: weather reports\n",
        "corpus = [\n",
        "    \"rain is likely in the north <eos>\",\n",
        "    \"sunny and warm with 28 degrees <eos>\",\n",
        "    \"cloudy with light wind in the north <eos>\",\n",
        "    \"sunny in the south with 31 degrees <eos>\",\n",
        "    \"light rain and 19 degrees in the south <eos>\"\n",
        "]\n",
        "\n",
        "# 2. Gold reward: prefer short reports that state a temperature\n",
        "def gold_reward(sentence):\n",
        "    words = [w for w in sentence.split() if w != \"<eos>\"]\n",
        "    return 1.0 * any(w.isdigit() for w in words) - 0.1 * len(words)\n",
        "\n",
        "# 3. Build the reference model\n",
        "follow = defaultdict(list)\n",
        "\n",
        "for sentence in corpus:\n",
        "    words = [\"<bos>\"] + sentence.split()\n",
        "    for a, b in zip(words, words[1:]):\n",
        "        follow[a].append(b)\n",
        "\n",
        "# 4. Sample a sentence from the reference model\n",
        "def sample(rng, max_words=12):\n",
        "    word = \"<bos>\"\n",
        "    out = []\n",
        "\n",
        "    while word != \"<eos>\" and len(out) < max_words:\n",
        "        if not follow[word]:\n",
        "            break\n",
        "        word = rng.choice(follow[word])\n",
        "        out.append(word)\n",
        "\n",
        "    return \" \".join(out)\n",
        "\n",
        "# 5. Generate and score six sentences\n",
        "def main():\n",
        "    rng = random.Random(0)\n",
        "\n",
        "    for _ in range(6):\n",
        "        sentence = sample(rng)\n",
        "        print(f\"{gold_reward(sentence):+.2f}  {sentence}\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    }
